# URL pública de producción (cambia esto a tu dominio propio al desplegar, ej. https://deve.com)
NEXT_PUBLIC_SITE_URL=https://deve.vercel.app

# Backend de tickets de consulta técnica (servidor privado, usado por /api/tickets)
TICKET_API_URL=https://fixtic.somee.com

# Contacto WhatsApp (solo dígitos con código de país, sin +)
NEXT_PUBLIC_WHATSAPP_NUMBER=5352529615
NEXT_PUBLIC_PHONE_DISPLAY=+53 5252 9615

# Link de descarga directa de la App Android (Play Store o APK). Si queda vacío, redirige a solicitud por WhatsApp.
NEXT_PUBLIC_ANDROID_APP_URL=

# ── Tienda integrada (POWERGY API) ──────────────────────────────
# URL pública del API de POWERGY. El proxy /api/powergy la usa desde el servidor
# (evita CORS y reenvía el token de Supabase del panel admin).
POWERGY_API_URL=https://powergy.somee.com

# Clave de tienda en el API de POWERGY (por defecto: deve -> pedidos DE-XXXXXXXX)
NEXT_PUBLIC_STORE_KEY=deve

# Supabase (mismo proyecto que POWERGY): acceso del panel /tienda/admin y Storage para fotos de productos
# En NEXT_PUBLIC_SUPABASE_ANON_KEY pega la Publishable key (sb_publishable_...) de Supabase → Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-publishable-key>
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=powergy-product-images
